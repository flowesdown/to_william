# TopArb configuration — copy to .env, fill credentials, NEVER commit .env

TOPARB_PAPER_TRADING=true
TOPARB_FORCE_CPU=0
TOPARB_LOG_LEVEL=INFO

TOPARB_UNIVERSE_SIZE=50
TOPARB_PCA_WINDOW=60

TOPARB_RISK_AVERSION=2.0
TOPARB_GAMMA_TDA=3.0
TOPARB_KAPPA_ANOMALY=1.5
TOPARB_N_PCA=10

TOPARB_MAX_LEVERAGE=2.0
TOPARB_DAILY_LOSS=0.05
TOPARB_DRAWDOWN_HALT=0.15
TOPARB_VAR_BUDGET=0.02
TOPARB_MAX_ORDER_USD=500000
TOPARB_REBAL_THRESH=0.02

TOPARB_FEED_MODE=yfinance
TOPARB_POLYGON_KEY=

TOPARB_IBKR_HOST=127.0.0.1
TOPARB_IBKR_PORT=7497
TOPARB_IBKR_CLIENT_ID=1

TOPARB_INFLUX_URL=
TOPARB_INFLUX_TOKEN=
TOPARB_INFLUX_ORG=toparb
TOPARB_INFLUX_BUCKET=toparb_metrics

TOPARB_BT_START=2018-01-01
TOPARB_BT_END=2024-12-31
TOPARB_CAPITAL=1000000.0
TOPARB_BENCHMARK=SPY
